# Secretos de PRODUCCIÓN de MACHOBOL. En el servidor se copia como deploy/.env (nunca se sube a git).
# Usa valores NUEVOS, distintos de los de desarrollo. Para generar un secreto de 48 bytes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Dominio y HTTPS ---------------------------------------------------------------------------
# Dominio que apunta a la IP fija del servidor (p. ej. machobol.duckdns.org o un dominio propio).
DOMINIO=
# Correo para Let's Encrypt (avisos de vencimiento del certificado).
EMAIL_ACME=

# --- Base de datos (Supabase São Paulo, Session pooler) ----------------------------------------
# Con la contraseña NUEVA de la base (resetéala en Supabase antes del primer despliegue).
DATABASE_URL=postgresql://postgres.ID_DEL_PROYECTO:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt

# --- API --------------------------------------------------------------------------------------
LOG_LEVEL=info
JWT_SECRET=
JWT_EXPIRES_IN=8h
COTIZACION_VALIDEZ_DIAS=15
# Secreto compartido entre la API y el servidor de acciones (mínimo 32 caracteres).
SERVICE_TOKEN=

# --- WhatsApp Business (Meta Cloud API) -------------------------------------------------------
# Token que eliges tú y escribes también en Meta al configurar el webhook (https://DOMINIO/api/webhooks/whatsapp).
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (verifica la firma de cada webhook). Mientras no haya app, un valor aleatorio.
WHATSAPP_APP_SECRET=
# Token de acceso y Phone Number ID: vacíos = modo simulado (nada sale hacia Meta).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v24.0
