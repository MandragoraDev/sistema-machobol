# Copia este archivo como .env y completa los valores.
# Si una contraseña tiene caracteres especiales (@, :, /, #), escríbela codificada en la URL (p. ej. @ → %40).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Conexión que usa la API: rol con privilegios mínimos, dueño de la base de datos "machobol".
DATABASE_URL=postgres://machobol_app:cambia_esta_clave@localhost:5432/machobol

# Base de datos exclusiva para `npm test` (su nombre debe terminar en _test: las pruebas la vacían).
# Si no la defines, se omiten las pruebas que usan PostgreSQL.
TEST_DATABASE_URL=postgres://machobol_app:cambia_esta_clave@localhost:5432/machobol_test

# Solo para `npm run db:setup`: conexión de superusuario que crea el rol y las bases de datos de arriba.
# Puedes borrarla del .env una vez ejecutado el setup.
PG_ADMIN_URL=postgres://postgres:clave_de_postgres@localhost:5432/postgres

# Firma de los tokens JWT: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Usuario Admin inicial que crea `npm run db:seed` (contraseña de al menos 8 caracteres).
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@machobol.local
ADMIN_PASSWORD=

# --- WhatsApp Business (Meta Cloud API) -------------------------------------------------------
# Texto que eliges tú y escribes también en Meta (WhatsApp > Configuración > Webhook > "Verify token").
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración de la app > Básica). Verifica la firma HMAC de cada webhook.
# Mientras no tengas la app, pon cualquier texto aleatorio: el simulador firma con este mismo valor.
WHATSAPP_APP_SECRET=
# Token de acceso y Phone Number ID (WhatsApp > Configuración de la API). Van juntos.
# Vacíos = modo simulado: el bot responde, pero nada sale hacia Meta (prueba con npm run whatsapp:simular).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v24.0

# --- Asistente Rasa ---------------------------------------------------------------------------
RASA_URL=http://localhost:5005
# Secreto que el servidor de acciones de Rasa envía en el header X-Service-Token (mínimo 32 caracteres).
# El mismo valor va en rasa_bot/.env. Genera uno con el comando de JWT_SECRET.
SERVICE_TOKEN=
