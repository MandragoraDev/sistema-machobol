{
  "name": "machobol-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST del Sistema Web Integral MACHOBOL",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "db:setup": "node src/db/scripts/setup.js",
    "db:migrate": "node-pg-migrate up -m src/db/migrations",
    "db:rollback": "node-pg-migrate down -m src/db/migrations",
    "db:reset": "node-pg-migrate down 0 -m src/db/migrations && npm run db:migrate && npm run db:seed",
    "db:migration:create": "node-pg-migrate create -m src/db/migrations --migration-file-language sql",
    "db:seed": "node src/db/seeds/run.js",
    "whatsapp:simular": "node scripts/simular-whatsapp.js",
    "tunel": "cloudflared tunnel --url http://localhost:4000"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js"
  }
}
