# Servidor de Rasa con el modelo ya entrenado (se entrena en el equipo de desarrollo y se sube con deploy/subir.sh).
# Contexto de construcción: rasa_bot/. La imagen oficial ejecuta `rasa` como usuario 1001 en /app.
FROM rasa/rasa:3.6.21

WORKDIR /app
COPY --chown=1001 config.yml domain.yml credentials.yml ./
# En Docker las acciones están en el contenedor "acciones", no en localhost.
COPY --chown=1001 docker/endpoints.yml ./endpoints.yml
COPY --chown=1001 models ./models

EXPOSE 5005
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5005/', timeout=4)"
# Escucha en la red interna de Docker (el puerto no se publica fuera del servidor). Sin --enable-api.
CMD ["run", "--interface", "0.0.0.0", "--port", "5005", "--endpoints", "endpoints.yml", "--credentials", "credentials.yml"]
